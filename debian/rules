#!/usr/bin/make -f

%:
	dh $@

override_dh_auto_configure:
	cmake -S . -B build-deb -G Ninja -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	cmake --build build-deb

override_dh_auto_install:
	DESTDIR=$(CURDIR)/debian/aze cmake --install build-deb --prefix /usr

override_dh_auto_test:
	LD_LIBRARY_PATH=$(CURDIR)/build-deb/AzeLib/bin $(CURDIR)/build-deb/Aze/bin/aze run-tests

override_dh_auto_clean:
	rm -rf build-deb
